# Copy this file to .env and fill in your real values.
# .env is gitignored - it is never committed.

# Fastmail IMAP login and app-specific password.
# Settings > Password & Security > App passwords, in Fastmail.
IMAP_USERNAME=you@fastmail.com
IMAP_APP_PASSWORD=

# Optional overrides (defaults shown).
# IMAP_HOST=imap.fastmail.com:993
# DB_PATH=real-estate-watch.db
# POLL_INTERVAL=5m

# Telegram notifications (optional - leave both empty to disable, or set
# both). Create a bot via https://t.me/BotFather, message it once, then find
# your chat id at https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
